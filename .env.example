# Copy to .env and adjust. Every value has a working default, so
# `docker compose up -d` works with no edits at all for a local trial.

# Port the app is served on (http://localhost:8080)
APP_PORT=8080

# Database credentials. Change these before any real deployment.
POSTGRES_USER=ayurcalm
POSTGRES_PASSWORD=ayurcalm
POSTGRES_DB=ayurcalm

# Signing secret for login sessions. Optional: left blank, the server generates
# one on first start and keeps it in the database, so sessions survive restarts.
# Set it yourself if you want to control the key or move the database between
# installs:  openssl rand -base64 32
JWT_SECRET=

# Your centre's name, printed at the top of the daily schedule PDF.
CENTRE_NAME=Wellness Centre

# Support WhatsApp seeded on first run, in international format with no
# plus sign or leading zero. Changed in Settings afterwards.
DEFAULT_SUPPORT_WHATSAPP=420777558262
