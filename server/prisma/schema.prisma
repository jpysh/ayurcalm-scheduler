generator client {
  provider      = "prisma-client-js"
  // "native" covers local development; the debian target is what the Docker
  // image needs, and Prisma will not fall back to it at runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id                String    @id @default(uuid())
  name              String
  /// Printed in their own row of the day sheet; with the two notes, on treatment days (#355).
  medication        String?
  before_treatment  String?
  after_treatment   String?
  gender            Gender
  phone             String?
  email             String?
  date_of_birth     DateTime?
  emergency_contact String?
  emergency_phone   String?
  /// Filled over time from the card ("More details"); the discharge summary asks for some of them.
  address           String?
  country           String?
  /// Passport or other ID.
  id_number         String?
  /// For Form C (#415), a foreign guest's visa: its number and last valid day (YYYY-MM-DD).
  visa_number       String?
  visa_valid_until  String?
  registration_number String?
  medical_notes     String?
  created_at        DateTime  @default(now())
  /// The therapist this resident is booked with when there is a choice.
  preferred_staff_id String?
  /// True when that is a condition of their treatment rather than a habit: the
  /// replan offers them a different time rather than different hands.
  requires_preferred_staff Boolean @default(false)
  /// The doctor's current plan for this resident, written after a consultation
  /// and read on the resident's card. One note, not a history: each
  /// consultation's own note stays on that appointment.
  doctor_plan String?
  /// The private link to their own schedule (#219): no sign-in, reissued to revoke.
  link_token String? @unique

  DietPlans        DietPlan[]
  DietPlanSegments DietPlanSegment[]
  Appointments     Appointment[]
  Stays            PatientStay[]
  Photo            PatientPhoto?
}

/// A photo of the guest's passport or ID, kept apart from the patient so no list loads it (#510).
model PatientPhoto {
  patient_id String   @id
  image      Bytes
  updated_at DateTime @default(now()) @updatedAt
  Patient    Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
}

model PatientStay {
  id            String   @id @default(uuid())
  patient_id    String
  start_date    DateTime
  end_date      DateTime
  duration_days Int
  /// False for a day patient, who does not sleep at the centre.
  on_site       Boolean  @default(true)
  /// Taken on arrival (#219): the first reading, free text ("BP 130/85, pulse 72").
  vitals        String?
  /// What the resident came about, in their words.
  concerns      String?
  /// External tests the doctor asked for (blood work, scans).
  tests         String?
  /// When the admin marked this stay's Form C as filed with the FRRO (#415).
  form_c_filed  DateTime?
  /// When the admin marked the follow-up the discharge summary asked for as done (#487).
  follow_up_done DateTime?
  /// How the guest said the stay was, from their link on the leaving day (#509): { rating: good | fine | poor, note, at }.
  feedback      Json?
  /// The discharge summary (#194): written by the doctor from their link or by
  /// the admin on the card; `final` is the admin's last word and locks the link.
  /// Shape is `Discharge` in src/discharge.ts.
  discharge     Json?
  /// What the patient chose from the centre's catalogues (stories 11 and 12), changeable any time in the stay.
  package_id       String?
  accommodation_id String?
  /// The guest room they sleep in (#456): one for the whole stay; a move changes it.
  guest_room_id    String?

  Patient       Patient            @relation(fields: [patient_id], references: [id])
  GuestRoom     GuestRoom?         @relation(fields: [guest_room_id], references: [id], onDelete: SetNull)
  Package       Package?           @relation(fields: [package_id], references: [id], onDelete: SetNull)
  Accommodation AccommodationType? @relation(fields: [accommodation_id], references: [id], onDelete: SetNull)
}

/// A Panchakarma package the centre sells (#285 story 11). Reference only: the price is one
/// figure with the registration charge included, and nothing here invoices or takes payment.
model Package {
  id        String  @id @default(uuid())
  name      String  @unique
  days      Int
  /// Whole rupees.
  price     Int
  notes     String?
  /// Retired ones stop being offered but stay readable by the stays that chose them.
  is_active Boolean @default(true)

  Stays PatientStay[]
}

/// A kind of room a patient may stay in (#285 story 12); the total is price per day times nights.
model AccommodationType {
  id            String  @id @default(uuid())
  name          String  @unique
  price_per_day Int
  notes         String?
  is_active     Boolean @default(true)

  Stays      PatientStay[]
  GuestRooms GuestRoom[]
}

/// A room a patient sleeps in (#456), "T3". Called a guest room on screen: "room" means a
/// treatment room. A night is held from the stay's first day up to, not including, its last.
model GuestRoom {
  id               String  @id @default(uuid())
  name             String  @unique
  accommodation_id String
  /// How many patients may share it; a couple is two patients in one room.
  beds             Int     @default(1)
  is_active        Boolean @default(true)

  Accommodation AccommodationType @relation(fields: [accommodation_id], references: [id], onDelete: Cascade)
  Stays         PatientStay[]
}

model Staff {
  id              String   @id @default(uuid())
  name            String
  gender          Gender
  specializations String[]
  phone           String?
  weekly_schedule Json
  is_active       Boolean  @default(true)
  /// "therapist" or "doctor". A doctor is booked for consultations, which are
  /// therapies with is_consultation set, through the same scheduler and guard.
  role            String   @default("therapist")
  /// The private link to their own day (#219): no sign-in, reissued to revoke.
  link_token      String?  @unique
  /// Printed under a doctor's signature on the discharge summary.
  qualification   String?
  reg_no          String?
  /// Signature image as a data: URI, kept in the row so backups keep it.
  signature       String?

  Appointments Appointment[]
}

model TherapyRoom {
  id              String   @id @default(uuid())
  name            String
  amenities       String[]
  weekly_schedule Json
  is_active       Boolean  @default(true)

  Appointments Appointment[]
}

model Therapy {
  id                    String   @id @default(uuid())
  name                  String
  required_amenities    String[]
  duration_minutes      Int
  /// False once deleted after it was given (#567): kept so done treatments keep its name.
  is_active             Boolean  @default(true)
  requires_gender_match Boolean  @default(false)
  /// How many therapists the treatment needs. A rule the guard enforces, not a
  /// choice made per booking: a four-hand Pizhichil always needs two.
  staff_required        Int      @default(1)
  /// A doctor's consultation rather than a treatment: given by a doctor, printed
  /// on the doctor rota, and followed by a prompt to review diet and therapies.
  is_consultation       Boolean  @default(false)
  /// Given once in a stay, like Vamana or Virechana (#365): Plan next week leaves
  /// it out, and booking a second one in the same stay is asked about.
  once_per_course       Boolean  @default(false)
  before_purification   Boolean  @default(false)
  /// What the therapist ticks before or during it (#219): [{ text, required }].
  checklist             Json     @default("[]")
  /// The readings taken at it; blood pressure unless the centre chose otherwise.
  vitals                String[] @default(["bp"])
  /// What the therapist brings: oils, powders, leaves. Printed on the therapist
  /// rota beside the treatment. A list, not stock: nothing is counted.
  products              String[] @default([])
  // Rest for the patient and cleanup for the room after an oil or steam
  // therapy. One number because no centre has asked to tell the two apart.
  description           String?

  Appointments Appointment[]
}

model Appointment {
  id               String            @id @default(uuid())
  patient_id       String
  therapy_id       String
  /// The lead therapist.
  staff_id         String?
  /// Everyone else working on it. A list rather than a join table so that every
  /// query for a day's appointments carries them without asking: a co-therapist
  /// left out of a busy check is a double booking.
  co_staff_ids     String[]          @default([])
  room_id          String?
  scheduled_date   DateTime
  start_time       String
  duration_minutes Int
  session_number   Int
  total_sessions   Int
  status           AppointmentStatus
  assignment_type  AssignmentType
  notes            String?
  /// Why it was cancelled ("stay shortened"); kept with it, and cleared if it is put back.
  cancel_reason    String?
  /// What the link views record on it (#219): checklist ticks, vitals, room
  /// ready, the resident's thumbs and note. Records only: never flagged, never printed.
  record           Json?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  Patient Patient      @relation(fields: [patient_id], references: [id])
  Therapy Therapy      @relation(fields: [therapy_id], references: [id])
  Staff   Staff?       @relation(fields: [staff_id], references: [id])
  Room    TherapyRoom? @relation(fields: [room_id], references: [id])
}

model TimeOff {
  id          String        @id @default(uuid())
  entity_type TimeOffEntity
  entity_id   String?
  date        DateTime?
  start_date  DateTime?
  end_date    DateTime?
  start_time  String?
  end_time    String?
  description String?

  @@map("Holiday")
}

model DietPlan {
  id           String   @id @default(uuid())
  patient_id   String
  date         DateTime
  meal_time    MealTime
  description  String
  instructions String?
  created_by   String
  created_at   DateTime @default(now())

  Patient Patient @relation(fields: [patient_id], references: [id])

  /// One entry per meal per day. Two rows for the same meal made the sheet
  /// print whichever the database returned last.
  @@unique([patient_id, date, meal_time])
}

model DietPlanSegment {
  id         String   @id @default(uuid())
  patient_id String
  start_date DateTime
  end_date   DateTime

  /// The plan this segment follows. Editing that plan reaches every patient on
  /// it who has not been given something different — which is the point of a
  /// template, and why this is a reference rather than a copy.
  template_id String?
  /// Fields the doctor changed for this patient only. These win over the
  /// template, so an edit to the template leaves them alone.
  overrides      Json?
  /// Names a bespoke plan that follows no template.
  template_label String?
  therapy_ids    String[]
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Patient  Patient       @relation(fields: [patient_id], references: [id])
  Template DietTemplate? @relation(fields: [template_id], references: [id])
}

model ProgramEvent {
  id                 String    @id @default(uuid())
  date               DateTime?
  start_date         DateTime?
  end_date           DateTime?
  start_time         String
  end_time           String
  activity_name      String
  room_id            String?
  staff_id           String?
  required_amenities String[]
  notes              String?
  recurrence         String?
  weekdays           String[]
  audience           String?
  /// Residents are expected at a required event, so a treatment across one is a
  /// treatment they will not attend. An optional class raises no such question.
  is_optional        Boolean   @default(false)
  patients_scope     String?
  patient_ids        String[]
  staff_scope        String?
  staff_ids          String[]
}

model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String
  action      String
  entity_type String
  entity_id   String
  old_value   Json?
  new_value   Json?
  timestamp   DateTime @default(now())
}

enum Gender {
  male
  female
  other
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  rescheduled
  /// The resident did not come (#136). Frees the room and therapist like a
  /// cancellation, but prints and counts as a no-show.
  no_show
}

enum AssignmentType {
  auto
  manual
}

enum TimeOffEntity {
  center
  staff
  room
  guest_room
  therapy
  patient

  @@map("HolidayEntity")
}

enum MealTime {
  breakfast
  lunch
  dinner
  snacks
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password_hash         String
  name                  String?
  role                  String    @default("staff")
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now())
  last_login            DateTime?
  password_reset_token  String?   @unique
  password_reset_expiry DateTime?
}

/// Centre-level configuration. Exactly one row, id "singleton" — this is a
/// single-centre install by design; run a second instance for a second centre.
model Settings {
  id                       String   @id @default("singleton")
  centre_name              String   @default("Wellness Centre")
  address                  String?
  /// The centre's timezone, which decides what "today" is everywhere — the
  /// schedule, the warnings and the day sheet. India by default: that is who
  /// this was built for, and a wrong guess prints the wrong day's sheet.
  timezone                 String   @default("Asia/Kolkata")
  /// The symbol before a price on the card, for reference (#609): Rs, $, €.
  currency                 String   @default("Rs")
  opening_time             String   @default("09:00")
  closing_time             String   @default("18:00")
  slot_minutes             Int      @default(30)
  working_days             String[] @default(["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"])
  /// Small logo as a data: URI, shown in the header and on the PDF.
  logo                     String?
  demo_data                Boolean  @default(false)
  /// Product support for the people running this software (admins and staff).
  /// International format, no plus sign or leading zero (e.g. 420777558262).
  support_whatsapp         String?
  /// Support shown to patients and other end users on their own pages. Defaults
  /// to the same contact; a centre normally changes this to its own reception.
  patient_support_whatsapp String?
  /// False until the first-run wizard has been completed or skipped.
  setup_complete           Boolean  @default(false)
  /// Whether a therapy marked as needing a gender match is allowed to be booked
  /// without one. On by default; a centre that asks residents turns it off.
  enforce_gender_match     Boolean  @default(true)
  /// A soft rule (#330): booking more than this many treatments for one resident
  /// on one day asks "Book anyway?". Never a refusal.
  max_treatments_per_day   Int      @default(4)
  /// The discharge summary's letterhead: seal logo, second-language name,
  /// registration and accreditation lines, phones, email, website, footer and
  /// the discharge number format. Shape is `Letterhead` in src/discharge.ts.
  letterhead               Json?
  /// Cloud trials only (TRIAL=true, #247): when the 30 days began, which is
  /// the first resident added or day sheet printed after setup. Null before.
  trial_started_at         DateTime?
  /// Billing (#250), set by hand with `centre.sh paid` until Razorpay:
  /// "cloud", "onprem" or "founding", and the day paid until. A plan lifts a
  /// trial's read-only; 14 days past paid_until it is read-only again.
  plan                     String?
  paid_until               DateTime?
  /// "Made with Ruta" on sheets and links (#249). Only a paying centre may turn it off.
  show_footer              Boolean  @default(true)
  /// What needs the admin (#288): only the rules the admin changed, `{ rule_id: { on?, hours? } }`. Defaults live in src/attention.ts.
  attention_rules          Json?
  /// The setup card's items the admin has looked at ("Set up your centre · 3 of 7 reviewed").
  setup_reviewed           String[] @default([])
  updated_at               DateTime @updatedAt
}

/// Signing secret for sessions, generated on first start when JWT_SECRET is
/// unset. Kept out of Settings because that row is returned to clients whole.
model ServerSecret {
  id         String   @id @default("singleton")
  jwt_secret String
  created_at DateTime @default(now())
  /// The AI assistant's key (#119): a hash only, shown once at download.
  /// Revoking clears it. The key acts as the admin who made it.
  mcp_key_hash         String?
  mcp_key_user_id      String?
  mcp_key_created_at   DateTime?
  mcp_key_last_used_at DateTime?
}

/// A reusable diet plan. Most patients are put on one of these rather than
/// getting something bespoke, so it is the centre's own content and belongs in
/// the database rather than in code.
///
/// Meals are held twice. What a patient eats on a day they are treated differs
/// from a rest day, and a resident eats on both, so one plan carries both sides
/// rather than going silent half the week.
model DietTemplate {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  therapy_breakfast String @default("")
  therapy_lunch     String @default("")
  therapy_dinner    String @default("")
  therapy_snacks    String @default("")

  rest_breakfast String @default("")
  rest_lunch     String @default("")
  rest_dinner    String @default("")
  rest_snacks    String @default("")

  /// Retired plans stop being offered but stay readable by the patients on them.
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Segments DietPlanSegment[]
}

/// Raised from a therapist's or doctor's link (#219): room unusable, co-therapist
/// or resident absent, SOS, a permission, a note. The admin sees it on the day.
model LinkIssue {
  id             String   @id @default(uuid())
  staff_id       String
  appointment_id String?
  kind           String
  note           String?
  created_at     DateTime @default(now())
  seen           Boolean  @default(false)
}

/// The last printed copy of each day's sheets (#145): what was on the notice
/// board, kept 90 days. In the database, so a backup keeps it with the rest.
model PrintedSheet {
  date       String
  /// residents, therapist or doctor
  kind       String
  pdf        Bytes
  printed_at DateTime @default(now())

  @@id([date, kind])
}
