# Staging Environment Configuration
# Copy to .env.staging and update values before deployment

# Database
STAGING_DB_PASSWORD=generate_secure_password_here
DATABASE_URL=postgresql://ayurcalm_staging:${STAGING_DB_PASSWORD}@db-staging:5432/ayurcalm_staging?schema=public

# Server
NODE_ENV=staging
PORT=4001
HOST=0.0.0.0

# API Security
API_TOKEN=staging_api_token_change_me

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000