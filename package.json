{
  "name": "ayurcalm-scheduler",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "npm --prefix server test",
    "dev:up": "docker compose build || { echo; echo 'BUILD FAILED: nothing was restarted, so :8080 is still the old code. Fix the error above and run this again.'; exit 1; } && docker compose up -d",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose build || { echo; echo 'BUILD FAILED: nothing was restarted, so :8080 is still the old code. Fix the error above and run this again.'; exit 1; } && docker compose down -v && docker compose up -d",
    "dev:logs": "docker compose logs -f app",
    "qa": "sh scripts/qa.sh",
    "qa:fresh": "npm run dev:reset && npm run qa"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  },
  "description": "Self-hosted appointment and therapy scheduler for Ayurveda wellness centres",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpysh/ayurcalm-scheduler.git"
  }
}
